# Copy to deploy/.env on the host; never commit the real file.
# Public hostname Caddy serves and obtains a certificate for.
FORMA_HOST=localhost
# JSON map of owner name to bearer token; each token at least 32 characters.
FORMA_API_TOKENS={"demo":"replace-with-at-least-32-random-characters"}
# Server-only Muse provider key. Leave empty to deploy with Muse actions disabled.
MODEL_API_KEY=
# Optional server-owned design-context manifest path inside the API container.
FORMA_DESIGN_CONTEXT_PATH=
