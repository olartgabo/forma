+@pytest.mark.parametrize("prefix,total", [(6, 14), (7, 15), (8, 16)])
+def test_attached_base_peel_front_rear_and_reattach(prefix, total):
+    base, snapshot, process = base_snapshot(prefix=prefix)
+    result = simulate(snapshot, process)
+    assert result.status == "feasible", result.blockers
+    assert rank_feasible((result,)) == (result,)
+    assert result.cost is not None and result.cost.known_weighted_cost == 8
+    assert result.cost.required_physical_undos == 2
+    assert result.cost.irreversible_completed_actions_lost == 0
+    plan = result.plan
+    assert len(plan.operations) == total
+    assert plan.operations[:prefix] == base.operations[:prefix]
+    base_parts = {p.id: p for p in base.parts}
+    assert {p.id: p for p in plan.parts if p.id in base_parts} == base_parts
+    assert tuple(j for j in plan.joints if j.id.startswith("stand-joint-"))[:3] == (
+        base.joints
+    )
+    base_checks = {c.id: c for c in base.checkpoints}
+    plan_checks = {c.id: c for c in plan.checkpoints}
+    completed_ops = {o.id for o in base.operations[:prefix]}
+    for check in base.checkpoints:
+        if check.after_operation_id in completed_ops:
+            assert plan_checks[check.id] == check
+    assert base_checks.keys() <= plan_checks.keys() or prefix == 7
+    new_id = next(p.id for p in plan.parts if p.id not in base_parts)
+    active = ("stand-support", new_id, "stand-brace")
+    new_part = next(p for p in plan.parts if p.id == new_id)
+    retired = base_parts["stand-base"]
+    assert (new_part.geometry.width, new_part.geometry.height) == (
+        retired.geometry.width,
+        retired.geometry.height,
+    )
+    assert new_part.features == retired.features
+    support = next(p for p in plan.parts if p.id == "stand-support")
+    assert support == base_parts["stand-support"]
+    fold = next(o for o in plan.operations if o.id == "stand-fold-lip")
+    assert fold == next(o for o in base.operations if o.id == "stand-fold-lip")
+    peels = [o for o in plan.operations if o.type == "detach"]
+    assert len(peels) == 2
+    assert [o.args.joint_id for o in peels] == [
+        "stand-joint-front",
+        "stand-joint-rear",
+    ]
+    assert tuple(result.required_undo_operation_ids) == tuple(o.id for o in peels)
+    assert set(result.lost_operation_ids) == {
+        "stand-joint-front-attach",
+        "stand-joint-rear-attach",
+    }
+    assert "stand-fold-lip" in result.preserved_operation_ids
+    assert "stand-joint-apex-attach" in result.preserved_operation_ids
+    assert "stand-joint-front-attach" not in result.preserved_operation_ids
+    assert "stand-joint-rear-attach" not in result.preserved_operation_ids
+    for stale in ("stand-inspect-fit", "stand-functional-test"):
