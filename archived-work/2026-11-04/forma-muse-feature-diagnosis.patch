+def _resolve_tape_active(parts, joints):
+    """Resolve the replacement role from exactly two new joints, or None.
+
+    Brace: new rear (base, replacement) and apex (support, replacement).
+    Base: new front (support, replacement) and rear (replacement, brace).
+    Any other shared-replacement topology (including a support replacement)
+    is unsupported here.
+    """
+    original_joints = {
+        "stand-joint-front": ("stand-support", "stand-base"),
+        "stand-joint-rear": ("stand-base", "stand-brace"),
+        "stand-joint-apex": ("stand-support", "stand-brace"),
+    }
+    extra = [j for jid, j in joints.items() if jid not in original_joints]
+    if len(extra) != 2 or any(len(j.part_ids) != 2 for j in extra):
+        return None
+    shared = set(extra[0].part_ids) & set(extra[1].part_ids)
+    if len(shared) != 1:
+        return None
+    replacement_id = next(iter(shared))
+    if replacement_id in _ORIGINALS or replacement_id not in parts:
+        return None
+    others = tuple(
+        pid for j in extra for pid in j.part_ids if pid != replacement_id
+    )
+    if set(others) == {"stand-base", "stand-support"}:
+        retired_id, role = "stand-brace", "brace"
+    elif set(others) == {"stand-support", "stand-brace"}:
+        retired_id, role = "stand-base", "base"
+    else:
+        return None
+    inverse = {pair: jid for jid, pair in original_joints.items()}
+    new_by_original: dict[str, str] = {}
+    for joint in extra:
+        mapped = tuple(
+            retired_id if pid == replacement_id else pid for pid in joint.part_ids
+        )
+        original_id = inverse.get(mapped)
+        if original_id is None or original_id in new_by_original:
+            return None
+        new_by_original[original_id] = joint.id
+    if len(new_by_original) != 2:
+        return None
+    peel_specs = tuple(
+        (
+            jid,
+            next(pid for pid in original_joints[jid] if pid != retired_id),
+        )
+        for jid in _JOINT_IDS
+        if jid in new_by_original
+    )
+    active_ordered = tuple(
+        replacement_id if pid == retired_id else pid for pid in _ORIGINALS
+    )
+    return _TapeActive(
+        replacement_id=replacement_id,
+        retired_id=retired_id,
+        role=role,
+        active_ordered=active_ordered,
+        new_joint_by_original=new_by_original,
+        peel_specs=peel_specs,
+        new_joints_in_peel_order=tuple(
