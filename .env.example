# No environment variables are required for the offline workspace.
# Export these in the process that needs them; this file is not loaded automatically.
# Never put real values in this file, and never prefix credentials with NEXT_PUBLIC_.

# API: provider credential for Muse requests. Server-only.
MODEL_API_KEY=
# API: optional Muse model id override (default muse-spark-1.3).
META_SPARK_MODEL=
# API: optional second model id override (default sam-3.1).
META_SAM_MODEL=

# API: optional local private project API. Empty configuration disables project access.
# JSON object: owner ID -> distinct secret token (at least 32 characters).
FORMA_API_TOKENS={}
# API: optional location for SQLite and private media (default .local/forma).
FORMA_DATA_DIR=.local/forma
# API: path to a server-owned JSON design-context manifest. Without a matching
# entry for the project and inventory revision, Muse design generation is blocked.
FORMA_DESIGN_CONTEXT_PATH=

# Web server: optional API origin for the private API proxy; no path or credentials.
FORMA_API_ORIGIN=http://127.0.0.1:8000

# Smoke CLI (python -m forma_api.demo_smoke): owner token used with --project-id.
FORMA_SMOKE_OWNER_TOKEN=
