# No environment variables are required for the offline workspace.
# Future model gateway only; leave unset until #4 verifies provider access.
# Keep this server-only. Never prefix credentials with NEXT_PUBLIC_.
MODEL_API_KEY=

# Optional local private project API. Empty configuration disables project access.
# JSON object: owner ID -> distinct secret token (at least 32 characters).
FORMA_API_TOKENS={}
FORMA_DATA_DIR=.local/forma
